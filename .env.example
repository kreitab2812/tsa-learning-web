DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Required in production: exact public origin, without a trailing slash.
# Leave unset for local development (localhost and 127.0.0.1 both work).
# APP_ORIGIN="https://your-domain.example"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_COURSE_PRESET=""

# Phase 2: Google Drive OAuth (server-only; never NEXT_PUBLIC_).
# See docs/google-drive.md. Do not commit real values.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/admin/drive/callback"
# Generate locally with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
GOOGLE_DRIVE_TOKEN_KEY=""
