generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Phân quyền Người dùng (RBAC)
enum Role {
  ADMIN
  STUDENT
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  role      Role       @default(STUDENT)
  progress  Progress[]
  createdAt DateTime   @default(now())
}

// --- TẦNG 1: KHÓA HỌC GỐC (VD: TSA - hocmai) ---
model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  stages      Stage[]  // Chứa nhiều Giai đoạn
  createdAt   DateTime @default(now())
}

// --- TẦNG 2: GIAI ĐOẠN ---
model Stage {
  id          String    @id @default(uuid())
  title       String
  description String?   // Thêm mô tả Giai đoạn
  color       String?   // Thêm mã màu (VD: #ef4444)
  order       Int       
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects    Subject[] 
}

// --- TẦNG 3: PHÂN MÔN ---
model Subject {
  id          String    @id @default(uuid())
  title       String
  description String?   // Thêm mô tả Môn học
  order       Int       
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  chapters    Chapter[] 
}

// --- TẦNG 4: CỤM KIẾN THỨC / CHƯƠNG (VD: Đại số, Hàm số) ---
model Chapter {
  id        String   @id @default(uuid())
  title     String
  order     Int      // Thứ tự Cụm kiến thức
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons   Lesson[] // Chứa nhiều Bài học
}

// --- TẦNG 5: BÀI HỌC CHI TIẾT ---
model Lesson {
  id          String     @id @default(uuid())
  title       String
  order       Int
  videoUrl    String?    // Link Video bài giảng
  documentUrl String?    // Link Tài liệu học tập (Nhiệm vụ/Phiếu học tập)
  exerciseUrl String?    // Link Bài tập sau buổi học (PDF gốc)
  answerUrl   String?    // Link Đáp án bài tập (PDF gốc)
  
  chapterId   String
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions   Question[] // Tích hợp bài tập tương tác trên web
  progress    Progress[]
}

// --- NGÂN HÀNG CÂU HỎI TƯƠNG TÁC ---
model Question {
  id            String  @id @default(uuid())
  lessonId      String
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content       String  // Nội dung đề bài
  imageUrl      String? // Ảnh đính kèm (nếu có sơ đồ, hình học)
  options       Json    // Mảng 4 đáp án (A, B, C, D)
  correctAnswer String  // Đáp án đúng
  explanation   String? // Lời giải chi tiết
  order         Int     
}

// --- TIẾN ĐỘ & ĐIỀU KIỆN MỞ KHÓA ---
model Progress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  videoCompleted Boolean  @default(false)
  exerciseScore  Float?   
  isCompleted    Boolean  @default(false)
  
  updatedAt      DateTime @updatedAt

  @@unique([userId, lessonId])
}
