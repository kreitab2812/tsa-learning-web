{
  "name": "tsa-learning-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "prisma validate && npm run typecheck && npm run lint",
    "test": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --env-file=.env --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "user:create": "node --env-file=.env --conditions=react-server --import tsx scripts/create-user.ts",
    "auth:cleanup": "node --env-file=.env --conditions=react-server --import tsx scripts/cleanup-auth.ts",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:audit": "node --env-file=.env scripts/audit-database.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.42.0",
    "next": "16.3.8",
    "next-cloudinary": "^6.18.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "read-excel-file": "9.3.10",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
